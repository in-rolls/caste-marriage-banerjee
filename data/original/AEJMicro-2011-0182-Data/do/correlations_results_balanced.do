sum diff_`k' p2_diff_`k' p97_diff_`k' corr_`k' p2_corr_`k' p97_corr_`k';
};
foreach k in edu res family caste{;
sum same`k' p2_same`k' p97_same`k';
};
save matlab/correlations_balanced_sample, replace;
